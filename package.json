{
  "name": "@mokngai/dsh-team-profile-ui",
  "version": "0.2.0",
  "type": "module",
  "description": "Team builder: a team-brief panel plus a preset that launches named subagents and tracks work on a todo_write task board for DSH",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent-team",
    "team-builder"
  ],
  "author": "mokngai",
  "license": "MIT",
  "homepage": "https://github.com/Michael-LY/dsh-team-profile-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michael-LY/dsh-team-profile-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Michael-LY/dsh-team-profile-ui/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
